# Server Port
PORT=3001

# Google Gemini API Keys (Required)
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Extra keys for multi-key parallel processing pipeline
GEMINI_API_KEY_2=your_second_gemini_api_key_here
GEMINI_API_KEY_3=your_third_gemini_api_key_here

# Optional: GitHub Personal Access Token (Increases rate limit from 60 to 5,000 req/hr)
# GITHUB_TOKEN=your_github_pat_here

# Environment
NODE_ENV=development
